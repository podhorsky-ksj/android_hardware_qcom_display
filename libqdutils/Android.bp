cc_library_shared {
    name: "libqdutils",
    vendor: true,
    defaults: ["display_defaults"],
    header_libs: ["libhardware_headers", "libutils_headers"],
    shared_libs: [
        "libbinder",
        "libqservice",
    ],
    cflags: [
        "-DDEBUG_CALC_FPS",
        "-DLOG_TAG=\"qdutils\"",
        "-Wno-sign-conversion",
    ],
    srcs: [
        "qd_utils.cpp",
        "display_config.cpp",
        "profiler.cpp"
    ],
}

// Keep the original gralloc1 handle/metadata ABI without colliding with the
// newer QSSI modules. Preserve the sonames expected by proprietary clients.
cc_library_shared {
    name: "libqdMetaData_legacy",
    stem: "libqdMetaData",
    vendor: true,
    defaults: ["display_defaults"],
    enabled: select(soong_config_variable("whyred_legacy_display", "enabled"), {
        "true": true,
        default: false,
    }),
    export_header_lib_headers: ["display_headers"],
    cflags: ["-Wno-sign-conversion", "-DLOG_TAG=\"qdmetadata\""],
    srcs: ["qdMetaData.cpp", "qd_utils.cpp"],
}

cc_library_shared {
    name: "libqdMetaData.system_legacy",
    stem: "libqdMetaData.system",
    defaults: ["display_defaults"],
    enabled: select(soong_config_variable("whyred_legacy_display", "enabled"), {
        "true": true,
        default: false,
    }),
    export_header_lib_headers: ["display_headers"],
    cflags: ["-Wno-sign-conversion", "-DLOG_TAG=\"qdmetadata\""],
    srcs: ["qdMetaData.cpp", "qd_utils.cpp"],
}
